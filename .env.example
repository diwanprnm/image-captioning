# Project Settings
PROJECT_NAME="Image Captioning Service"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# 9Router Configuration
NINE_ROUTER_BASE_URL="http://host.docker.internal:3000" # Or your 9router public IP:port
NINE_ROUTER_API_KEY="***"
NINE_ROUTER_VISION_MODEL="combofreetwo" # e.g., gpt-4-vision-preview, gemini-pro-vision

# Postgres Database Configuration (for Docker Compose)
POSTGRES_SERVER="db" # Hostname of the database service in Docker Compose
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="***"
POSTGRES_DB="caption_db"
POSTGRES_PORT=5433 # Mapped to 5432 in container